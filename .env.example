# Copy to .env and fill real values. .env is gitignored — never commit it.

# Google Gemini TTS (voiceover) — from Google AI Studio
GEMINI_API_KEY=

# Pexels (stock video search/download) — from pexels.com/api
PEXELS_API_KEY=

# Anthropic (Claude Opus: topic -> script + video JSON)
# Required only if JSON generation is automated (build-readiness decision #4)
ANTHROPIC_API_KEY=

# YouTube Data API v3 auto-upload — OAuth 2.0, NOT a plain API key.
# Create an OAuth "Desktop" client in Google Cloud Console; a one-time
# consent helper (provided at build) produces the refresh token.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
