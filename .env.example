# Copy to .env and fill real values. .env is gitignored — never commit it.

# Google Gemini TTS (voiceover) — from Google AI Studio
GEMINI_API_KEY=

# Pexels (stock video search/download) — from pexels.com/api
PEXELS_API_KEY=

# Anthropic (Claude Opus: topic -> script + video JSON)
# Required only if JSON generation is automated (build-readiness decision #4)
ANTHROPIC_API_KEY=

# OpenRouter — FREE text-LLM fallback when Anthropic fails (out of credits,
# network error, etc). Sign up at openrouter.ai and create a key; the free
# tier cascade hits DeepSeek V3 / Llama 3.3 70B / Qwen 2.5 72B — all
# long-context, no card required. Multiple keys are rotated automatically.
#   OPENROUTER_API_KEY=             # single key (simplest)
#   OPENROUTER_API_KEY_1=…          # optional extra keys (1…24) for rotation
#   OPENROUTER_LLM_MODEL=           # optional: pin one model, e.g.
#                                   #   deepseek/deepseek-r1:free
OPENROUTER_API_KEY=

# YouTube Data API v3 auto-upload — OAuth 2.0, NOT a plain API key.
# Create an OAuth "Desktop" client in Google Cloud Console; a one-time
# consent helper (provided at build) produces the refresh token.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
